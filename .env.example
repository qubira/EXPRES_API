# Cadena de conexion de Neon (PostgreSQL). Incluye ?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/express_ancon?sslmode=require

# Puerto del servidor (Render lo inyecta automaticamente, pero se usa en local)
PORT=4000

# Secreto para firmar tokens JWT (admin, tiendas, repartidores)
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# Origenes permitidos para CORS, separados por coma (dominio de Vercel)
CORS_ORIGIN=http://localhost:5500,https://tu-app.vercel.app

# Tarifa fija de delivery por defecto (soles)
DELIVERY_FEE_DEFAULT=5.00

# Cloudinary (almacenamiento de imagenes: comprobantes de pago y fotos de productos)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
